
mach create "haven_1"
machine LoadPlatformDescription @renode/haven.repl
sysbus LoadELF @firmware/build/haven.elf
emulation CreateUartPtyTerminal "uart1" "/tmp/haven_uart_1" true
uart1 AttachTo sysbus.uart

mach create "haven_2"
machine LoadPlatformDescription @renode/haven.repl
sysbus LoadELF @firmware/build/haven.elf
emulation CreateUartPtyTerminal "uart2" "/tmp/haven_uart_2" true
uart2 AttachTo sysbus.uart

mach create "haven_3"
machine LoadPlatformDescription @renode/haven.repl
sysbus LoadELF @firmware/build/haven.elf
emulation CreateUartPtyTerminal "uart3" "/tmp/haven_uart_3" true
uart3 AttachTo sysbus.uart

start
